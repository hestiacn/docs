{
	"name": "hestia",
	"private": true,
	"version": "1.9.3",
	"description": "An open-source Linux web server control panel.",
	"repository": "https://github.com/hestiacp/hestiacp",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=8.7.1"
	},
	"scripts": {
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:serve": "vitepress serve docs",
		"docs:test": "vitest run --config docs/.vitepress/vitest.config.js",
		"build": "node build.js",
		"lint": "prettier --cache --check . && eslint --cache . && stylelint web/css/src/**/*.css && markdownlint-cli2 *.md docs/**/*.md",
		"lint-staged": "lint-staged",
		"format": "prettier --cache --write .",
		"preinstall": "npx only-allow pnpm",
		"prepare": "husky",
		"audit": "pnpm audit --prod --audit-level=moderate"
	},
	"dependencies": {
		"@alpinejs/collapse": "^3.14.9",
		"@fortawesome/fontawesome-free": "^6.7.2",
		"@fortawesome/fontawesome-svg-core": "^6.7.2",
		"@fortawesome/free-solid-svg-icons": "^6.7.2",
		"@fortawesome/vue-fontawesome": "^3.0.8",
		"@vueuse/core": "^9.13.0",
		"@xterm/addon-canvas": "^0.7.0",
		"@xterm/addon-webgl": "^0.18.0",
		"@xterm/xterm": "^5.5.0",
		"alpinejs": "^3.14.9",
		"chart.js": "^4.4.8",
		"check-password-strength": "^3.0.0",
		"element-plus": "^2.9.6",
		"floating-vue": "^5.2.2",
		"lodash.debounce": "^4.0.8",
		"minisearch": "^7.1.2",
		"nanoid": "^5.1.5",
		"normalize.css": "^8.0.1",
		"parallax-js": "^3.1.0"
	},
	"devDependencies": {
		"@mdit-vue/shared": "^2.1.3",
		"@prettier/plugin-php": "^0.22.4",
		"@testing-library/vue": "^8.1.0",
		"@vitejs/plugin-legacy": "^5.2.2",
		"@vitejs/plugin-vue": "^5.2.2",
		"browserslist": "^4.23.0",
		"esbuild": "^0.21.0",
		"eslint": "^9.4.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-editorconfig": "^4.0.3",
		"eslint-plugin-import": "^2.29.0",
		"flexsearch": "^0.7.43",
		"husky": "^9.0.0",
		"jsdom": "^26.0.0",
		"lightningcss": "^1.25.0",
		"lint-staged": "^15.2.0",
		"markdownlint-cli2": "^0.17.2",
		"prettier": "^3.5.3",
		"prettier-plugin-nginx": "^1.0.3",
		"prettier-plugin-sh": "^0.15.0",
		"prettier-plugin-sql": "^0.18.1",
		"sass": "^1.86.0",
		"stylelint": "^16.6.0",
		"stylelint-config-standard": "^37.0.0",
		"vite": "^6.2.5",
		"vitepress": "^1.6.3",
		"vitepress-plugin-search": "^1.0.4-alpha.22",
		"vitest": "^1.6.0",
		"vue": "^3.5.13",
		"wrangler": "^3.25.0"
	},
	"pnpm": {
		"overrides": {
			"sass": "^1.86.0",
			"vite": "^6.2.5",
			"vue": "^3.5.13"
		}
	}
}
